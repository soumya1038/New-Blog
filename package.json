{
  "name": "blog-app",
  "version": "1.1.14",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:help": "npm --prefix redirect run test:help --",
    "clean": "npm run clean --workspaces --if-present",
    "help:accessibility-environment": "node scripts/report-help-accessibility-environment.js",
    "help:accessibility-readiness": "node scripts/report-help-accessibility-readiness.js",
    "help:accessibility-verification": "node scripts/create-help-accessibility-verification-packet.js",
    "help:analytics-approval": "node scripts/create-help-analytics-approval-packet.js",
    "help:analytics-readiness": "node scripts/report-help-analytics-readiness.js",
    "help:android-device-evidence": "node scripts/report-help-android-device-evidence.js",
    "help:android-evidence": "node scripts/create-help-android-evidence-packet.js",
    "help:android-readiness": "node scripts/report-help-android-readiness.js",
    "help:android-worksheet": "node scripts/create-help-android-verification-worksheet.js",
    "help:coverage-approval": "node scripts/create-help-coverage-approval-packet.js",
    "help:exception-decision": "node scripts/create-help-release-exception-decision-packet.js",
    "help:external-worksheet": "node scripts/create-help-external-verification-worksheet.js",
    "help:exceptions": "node scripts/report-help-exceptions.js",
    "help:gate-closure": "node scripts/report-help-gate-closure-readiness.js",
    "help:goal-audit": "node scripts/report-help-goal-audit.js",
    "help:governance": "node scripts/verify-help-governance.js",
    "help:open-gate-handoff": "node scripts/create-help-open-gate-owner-handoff.js",
    "help:open-gate-owners": "node scripts/report-help-open-gate-owners.js",
    "help:policy-approval": "node scripts/create-help-policy-approval-packet.js",
    "help:policy-readiness": "node scripts/report-help-policy-readiness.js",
    "help:public-routes": "node scripts/verify-help-public-routes.js",
    "help:readiness": "node scripts/report-help-readiness.js",
    "help:release-evidence-binder": "node scripts/create-help-release-evidence-binder.js",
    "help:release-record-audit": "node scripts/report-help-release-record-audit.js",
    "help:release-evidence-status": "node scripts/report-help-release-evidence-status.js",
    "help:release-pass-checklist": "node scripts/create-help-release-pass-checklist.js",
    "help:release-candidate": "node scripts/create-help-release-candidate.js",
    "help:support-cleanup": "node backend/scripts/supportCleanupAudit.js --prefix QA-CLEANUP",
    "help:support-lifecycle": "node scripts/create-help-support-lifecycle-packet.js",
    "help:support-readiness": "node scripts/report-help-support-readiness.js",
    "help:visual-evidence": "node scripts/create-help-visual-evidence-packet.js",
    "help:visual-readiness": "node scripts/report-help-visual-readiness.js",
    "help:visual-worksheet": "node scripts/create-help-visual-evidence-worksheet.js",
    "release:overall": "node scripts/prepare-overall-release.js",
    "version:push": "node scripts/bump-push-version.js",
    "version:prepush": "node scripts/bump-push-version.js --promote-minor",
    "version:release": "node scripts/bump-push-version.js --include-overall --require-main --promote-minor"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "docker": "^1.0.0"
  }
}
