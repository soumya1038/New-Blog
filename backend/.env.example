PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRE=7d
NODE_ENV=production
FRONTEND_URL=https://your-frontend-url.onrender.com
PUBLIC_SITE_URL=https://your-public-site-url.com

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

google_client_id=your_google_client_id
google_client_Secret=your_google_client_secret

GROQ_API_KEY=your_groq_api_key

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=12
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=180
COMMENT_RATE_LIMIT_WINDOW_MS=60000
COMMENT_RATE_LIMIT_MAX=6

# Comment guard
COMMENT_MAX_LENGTH=4000
COMMENT_MAX_LINKS=4
COMMENT_DUPLICATE_WINDOW_MS=120000

# Cache + Redis (optional but recommended)
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=300
CACHE_TTL_LIST_SECONDS=180
CACHE_TTL_DETAIL_SECONDS=300
CACHE_TTL_SEO_SECONDS=600
CACHE_TTL_BLOG_LIST_SECONDS=180
CACHE_TTL_BLOG_DETAIL_SECONDS=300
CACHE_TTL_ARTICLE_LIST_SECONDS=180
CACHE_TTL_ARTICLE_DETAIL_SECONDS=300
CACHE_TTL_SHORT_LIST_SECONDS=120
CACHE_TTL_SHORT_DETAIL_SECONDS=180
CACHE_TTL_COMMENT_LIST_SECONDS=90
CACHE_TTL_COMMENT_REPLIES_SECONDS=90

# Full-text search
SEARCH_MIN_QUERY_LENGTH=2
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=20
SEARCH_MAX_PAGE=50
