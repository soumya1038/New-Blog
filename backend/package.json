{
  "name": "blog-backend",
  "version": "1.7.25",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "node jobs/queueWorker.js",
    "check-livekit": "node check-livekit.js",
    "check-startup": "node check-startup.js",
    "diagnose": "node check-startup.js",
    "indexes:create": "node createIndexes.js",
    "secrets:provision-local": "node scripts/provisionLocalSecrets.js",
    "smoke:queue-redis": "node scripts/smokeQueueRedis.js",
    "smoke:security": "node scripts/smokeEnvValidationGuards.js && node scripts/smokeAuthBearerGuards.js && node scripts/smokeEncryptionGuards.js && node scripts/smokeDigitalDownloadGuards.js && node scripts/smokePaymentProviderGuards.js && node scripts/smokeStatusPrivacyGuards.js && node scripts/smokeSchedulerGuards.js && node scripts/smokeMessageConcurrencyGuards.js && node scripts/smokeContentPrivacyLoadGuards.js",
    "migrate:api-keys": "node scripts/migrateApiKeysToHashes.js",
    "migrate:api-keys:execute": "node scripts/migrateApiKeysToHashes.js --execute --confirm-migrate-api-keys",
    "migrate:message-media": "node scripts/migrateMessageMediaToAuthenticated.js",
    "migrate:message-media:execute": "node scripts/migrateMessageMediaToAuthenticated.js --execute --confirm-migrate-message-media",
    "migrate:encryption": "node scripts/migrateEncryptedDataToV2.js",
    "migrate:encryption:execute": "node scripts/migrateEncryptedDataToV2.js --execute --confirm-migrate-encrypted-data",
    "audit:user-emails": "node scripts/auditDuplicateUserEmails.js",
    "backfill:facebook-social:dry": "node scripts/backfillFacebookSocialLinks.js",
    "backfill:facebook-social": "node scripts/backfillFacebookSocialLinks.js --execute --confirm-backfill-facebook-social-links",
    "support:cleanup:dry": "node scripts/supportCleanupAudit.js --prefix QA-CLEANUP"
  },
  "dependencies": {
    "@sentry/node": "^7.120.4",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.3",
    "cloudinary": "^2.7.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "groq-sdk": "^0.33.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.15.0",
    "mongoose": "^8.24.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "openai": "^6.3.0",
    "razorpay": "^2.9.6",
    "redis": "^6.1.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "overrides": {
    "engine.io": "6.6.9",
    "path-to-regexp": "0.1.13",
    "socket.io-adapter": "2.5.8",
    "socket.io-parser": "4.2.6",
    "ws": "8.21.0"
  }
}
