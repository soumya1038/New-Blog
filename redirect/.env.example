REACT_APP_API_URL=https://your-backend-url.onrender.com
# Production builds should not publish source maps with client source.
GENERATE_SOURCEMAP=false
# Optional: override backend WS proxy URL if needed
# REACT_APP_WHISPER_PROXY_WS_URL=wss://your-backend-url.onrender.com/api/voice/whisper/ws
# Optional: enable privileged background-removal warmup calls only in controlled/admin deployments.
REACT_APP_ENABLE_BG_REMOVER_WARMUP=false

# Sentry error tracking (optional)
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_ENVIRONMENT=production
REACT_APP_SENTRY_RELEASE=redirect@1.0.5
REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0.1
